import { afterEach, describe, expect, it, vi } from 'vitest';
import { flushSync, mount, unmount } from 'svelte';
import { setServices } from '../../../lib/contracts/services';
import { createMockServices } from '../../../lib/contracts/mock';
import Circle from './Circle.svelte';
import Join from '../join/Join.svelte';

let app: Record<string, any> | null = null;
afterEach(() => {
  if (app) unmount(app);
  app = null;
  document.body.innerHTML = '';
});

describe('family area and join flow', () => {
  it('renders family circle area empty state when no circle', async () => {
    const services = createMockServices(Date.now());
    services.family.circle = vi.fn().mockResolvedValue(null);
    setServices(services);
    app = mount(Circle, { target: document.body });
    // wait for load
    await new Promise(r => setTimeout(r, 0));
    flushSync();
    expect(document.querySelector('[data-testid="area-family-circle"]')).not.toBeNull();
    expect(document.body.textContent).toContain('Crear círculo');
  });

  it('renders family circle with members when in a circle', async () => {
    const services = createMockServices(Date.now());
    setServices(services);
    app = mount(Circle, { target: document.body });
    await new Promise(r => setTimeout(r, 0));
    flushSync();
    expect(document.body.textContent).toContain('Familia Demo');
    expect(document.body.textContent).toContain('Ana');
    expect(document.body.textContent).toContain('Rosa (mamá)');
    expect(document.body.textContent).toContain('Luis');
  });

  it('renders the join page and shows SAS on submit', async () => {
    const services = createMockServices(Date.now());
    setServices(services);

    app = mount(Join, { target: document.body });
    flushSync();
    expect(document.querySelector('[data-testid="area-join"]')).not.toBeNull();
    expect(document.body.textContent).toContain('Unirse a una familia');

    const input = document.querySelector('input') as HTMLInputElement;
    input.value = 'Carlos';
    input.dispatchEvent(new Event('input', { bubbles: true }));
    flushSync();

    const button = document.querySelector('button') as HTMLButtonElement;
    button.click();

    // wait for promise to resolve in microtasks
    await new Promise(r => setTimeout(r, 10));
    flushSync();

    expect(document.body.textContent).toContain('Esperando aprobación');
    expect(document.body.textContent).toContain('482 913'); // default mock sas
  });
});
