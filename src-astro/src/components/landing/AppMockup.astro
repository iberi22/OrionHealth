---
// This is a static HTML/CSS mockup of the phone app using demo values from mock.ts
// Medical ID: Ana Demo, Blood: O+, Allergy: Penicilina
// Vitals: Rosa, BP 165/95 mmHg
---

<div class="phone">
  <div class="screen">
    <div class="status-bar">
      <span class="time">09:41</span>
      <div class="icons">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>
      </div>
    </div>
    <div class="app-content">
      <header>
        <h2>OrionHealth</h2>
        <div class="avatar">A</div>
      </header>

      <div class="card medical-id">
        <div class="card-header">
          <h3>Medical ID</h3>
          <span class="badge">Ana Demo</span>
        </div>
        <div class="card-body">
          <div class="row"><span class="label">Sangre:</span> <span class="value">O+</span></div>
          <div class="row"><span class="label">Alergias:</span> <span class="value danger">Penicilina</span></div>
          <div class="row"><span class="label">Contacto:</span> <span class="value">Luis (Hermano)</span></div>
        </div>
      </div>

      <div class="card family-vitals">
        <div class="card-header">
          <h3>Signos Vitales</h3>
          <span class="badge rosa">Rosa</span>
        </div>
        <div class="card-body">
          <div class="vital-reading alert">
            <span class="vital-label">Presión Arterial</span>
            <span class="vital-value">165 / 95 <small>mmHg</small></span>
            <span class="vital-time">Hace 1h</span>
          </div>
          <div class="vital-reading">
            <span class="vital-label">Glucosa</span>
            <span class="vital-value">104 <small>mg/dL</small></span>
            <span class="vital-time">Hace 2h</span>
          </div>
        </div>
      </div>
    </div>

    <div class="home-indicator"></div>
  </div>
</div>

<style>
  .phone {
    width: 300px;
    height: 600px;
    background: #111;
    border-radius: 40px;
    padding: 12px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    position: relative;
    margin: 0 auto;
    border: 2px solid #333;
  }

  .screen {
    background: var(--oh-bg, #f5f5dc);
    width: 100%;
    height: 100%;
    border-radius: 32px;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    color: var(--oh-text, #121212);
  }

  .status-bar {
    display: flex;
    justify-content: space-between;
    padding: 12px 20px;
    font-size: 12px;
    font-weight: 600;
  }

  .app-content {
    padding: 16px;
    flex: 1;
    overflow-y: auto;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  header h2 {
    margin: 0;
    font-size: 20px;
    color: var(--oh-accent, #10b981);
  }

  .avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--oh-secondary, #06b6d4);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
  }

  .card {
    background: var(--oh-surface, #e8e8c0);
    border-radius: var(--oh-radius, 14px);
    padding: 16px;
    margin-bottom: 16px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .card-header h3 {
    margin: 0;
    font-size: 16px;
  }

  .badge {
    background: var(--oh-accent-light, #34d399);
    color: #000;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: bold;
  }

  .badge.rosa {
    background: var(--oh-secondary, #06b6d4);
    color: #fff;
  }

  .row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 14px;
  }

  .label {
    color: var(--oh-muted, #4b5563);
  }

  .value {
    font-weight: 600;
  }

  .value.danger {
    color: var(--oh-danger, #f87171);
  }

  .vital-reading {
    display: flex;
    flex-direction: column;
    padding: 12px;
    background: var(--oh-bg, #f5f5dc);
    border-radius: 8px;
    margin-bottom: 8px;
  }

  .vital-reading.alert {
    border-left: 4px solid var(--oh-danger, #f87171);
  }

  .vital-label {
    font-size: 12px;
    color: var(--oh-muted, #4b5563);
  }

  .vital-value {
    font-size: 20px;
    font-weight: bold;
    margin: 4px 0;
  }

  .vital-value small {
    font-size: 12px;
    font-weight: normal;
    color: var(--oh-muted, #4b5563);
  }

  .vital-time {
    font-size: 11px;
    color: var(--oh-muted, #4b5563);
  }

  .home-indicator {
    width: 100px;
    height: 4px;
    background: #ccc;
    border-radius: 2px;
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
  }
</style>
