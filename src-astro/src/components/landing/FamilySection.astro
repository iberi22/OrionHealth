---
import { SECTIONS } from './content';
import { Card } from '@swal/ui';

const familySection = SECTIONS.find(s => s.id === 'family');
---

{familySection && (
  <section class="family-section">
    <div class="content-wrapper">
      <div class="text-content">
        <h2>{familySection.title}</h2>
        <p>{familySection.description}</p>
        <ul class="features-list">
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--oh-accent)"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            Sincronización P2P
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--oh-accent)"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            Permisos granulares (lectura/escritura)
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--oh-accent)"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            Alertas de signos vitales
          </li>
        </ul>
      </div>

      <div class="visual-content">
        <Card variant="elevated" padding="lg">
          <div class="family-mockup">
            <div class="family-header">Círculo: Mi Familia</div>
            <div class="member">
              <div class="avatar admin">Yo</div>
              <div class="member-info">
                <span class="name">Ana</span>
                <span class="role">Admin</span>
              </div>
            </div>
            <div class="member">
              <div class="avatar">R</div>
              <div class="member-info">
                <span class="name">Rosa</span>
                <span class="role">Guardian (Lectura)</span>
              </div>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>
)}

<style>
  .family-section {
    background: var(--oh-surface);
    padding: 4rem 1rem;
    margin: 2rem 0;
  }

  .content-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    align-items: center;
  }

  .text-content {
    flex: 1;
  }

  h2 {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--oh-text);
    margin-bottom: 1rem;
  }

  p {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--oh-muted);
    margin-bottom: 1.5rem;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .features-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    color: var(--oh-text);
    font-weight: 500;
  }

  .visual-content {
    flex: 1;
    width: 100%;
    max-width: 400px;
  }

  .family-mockup {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .family-header {
    font-weight: 700;
    font-size: 1.1rem;
    border-bottom: 1px solid var(--oh-muted);
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .member {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--oh-secondary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
  }

  .avatar.admin {
    background: var(--oh-accent);
  }

  .member-info {
    display: flex;
    flex-direction: column;
  }

  .name {
    font-weight: 600;
  }

  .role {
    font-size: 0.85rem;
    color: var(--oh-muted);
  }

  @media (min-width: 768px) {
    .content-wrapper {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
