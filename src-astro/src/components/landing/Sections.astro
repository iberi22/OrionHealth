---
import { SECTIONS } from './content';
import { Card } from '@swal/ui';

// Filter out the family section if we want it to be distinct, or render them all.
// The requirements say "sections for privacy..., family health circle, knowledge base, local AI, open source".
// We have a separate FamilySection, so we'll omit 'family' from this generic grid.
const gridSections = SECTIONS.filter(s => s.id !== 'family');
---

<section class="features">
  <h2>Características Principales</h2>
  <div class="grid">
    {gridSections.map((section) => (
      <Card variant="surface" padding="lg">
        <h3>{section.title}</h3>
        <p>{section.description}</p>
      </Card>
    ))}
  </div>
</section>

<style>
  .features {
    padding: 4rem 1rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 2rem;
    text-align: center;
    color: var(--oh-text);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--oh-accent);
    margin-bottom: 0.75rem;
  }

  p {
    color: var(--oh-muted);
    line-height: 1.6;
    margin: 0;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
