---
import { t } from '../../i18n/ui';

const currentUrl = Astro.url;
const lang = currentUrl.searchParams.get('lang') === 'en' ? 'en' : 'es';

const getLocalizedUrl = (path: string) => {
  return `${path}?lang=${lang}`;
};
---

<footer class="footer" data-testid="site-footer">
  <div class="footer-bg-glow"></div>
  <div class="footer-content">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="brand-header">
          <div class="brand-icon">
            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <span class="brand-name">ORION<span class="brand-accent">HEALTH</span></span>
        </div>
        <p class="brand-description">{t(lang, 'footer.description')}</p>
        <div class="social-links">
          <a href="https://github.com/iberi22/OrionHealth" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg class="social-icon" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="footer-links">
        <h3 class="links-title">{t(lang, 'footer.links')}</h3>
        <ul class="links-list">
          <li><a href={getLocalizedUrl('/')} class="link-item">{t(lang, 'nav.home')}</a></li>
          <li><a href={getLocalizedUrl('/app')} class="link-item">{t(lang, 'nav.app')}</a></li>
          <li><a href={getLocalizedUrl('/docs')} class="link-item">{t(lang, 'nav.docs')}</a></li>
          <li><a href={getLocalizedUrl('/kb')} class="link-item">{t(lang, 'nav.kb')}</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h3 class="links-title">{t(lang, 'footer.legal')}</h3>
        <ul class="links-list">
          <li><a href="https://github.com/iberi22/OrionHealth" class="link-item" target="_blank" rel="noopener noreferrer">{t(lang, 'footer.githubRepo')}</a></li>
          <li><a href="https://www.gnu.org/licenses/agpl-3.0" class="link-item" target="_blank" rel="noopener noreferrer">{t(lang, 'footer.license')}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">{t(lang, 'footer.copyright')}</p>
      <div class="made-with">
        <span>{t(lang, 'footer.builtWith')}</span>
        <span class="heart">♥</span>
        <span>{t(lang, 'footer.forPrivacy')}</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: 4rem;
    border-top: 1px solid var(--oh-glass-border);
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  @media (min-width: 768px) {
    .footer {
      margin-top: 8rem;
    }
  }

  .footer-bg-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(16, 185, 129, 0.05), transparent);
    pointer-events: none;
  }

  .footer-content {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    padding: 2.5rem 1rem;
  }

  @media (min-width: 768px) {
    .footer-content {
      padding: 4rem 1.5rem;
    }
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
      gap: 3rem;
    }
  }

  .footer-brand {
    grid-column: span 2;
  }

  @media (min-width: 768px) {
    .footer-brand {
      grid-column: span 1;
    }
  }

  .brand-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .brand-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    background: linear-gradient(to bottom right, var(--oh-accent), var(--oh-secondary));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .brand-icon {
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  .icon {
    width: 1rem;
    height: 1rem;
    color: var(--oh-bg);
  }

  @media (min-width: 768px) {
    .icon {
      width: 1.5rem;
      height: 1.5rem;
    }
  }

  .brand-name {
    font-size: 1rem;
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .brand-name {
      font-size: 1.25rem;
    }
  }

  .brand-accent {
    color: var(--oh-accent);
  }

  .brand-description {
    font-size: 0.75rem;
    color: var(--oh-nav-text);
    opacity: 0.6;
    line-height: 1.6;
    max-width: 28rem;
    margin: 0;
  }

  @media (min-width: 768px) {
    .brand-description {
      font-size: 0.875rem;
    }
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .social-links {
      margin-top: 1.5rem;
    }
  }

  .social-link {
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    border: 1px solid var(--oh-border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.5s ease;
    color: var(--oh-nav-text);
  }

  @media (min-width: 768px) {
    .social-link {
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  .social-link:hover {
    background-color: rgba(16, 185, 129, 0.1);
    border-color: var(--oh-accent);
  }

  .social-icon {
    width: 1rem;
    height: 1rem;
  }

  @media (min-width: 768px) {
    .social-icon {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  .links-title {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--oh-nav-text);
    opacity: 0.6;
    margin: 0 0 0.75rem 0;
  }

  @media (min-width: 768px) {
    .links-title {
      font-size: 0.75rem;
      letter-spacing: 0.3em;
      margin-bottom: 1rem;
    }
  }

  .links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .links-list {
      gap: 0.75rem;
    }
  }

  .link-item {
    text-decoration: none;
    font-size: 0.75rem;
    color: var(--oh-nav-text);
    opacity: 0.8;
    transition: all 0.5s ease;
  }

  @media (min-width: 768px) {
    .link-item {
      font-size: 0.875rem;
    }
  }

  .link-item:hover {
    color: var(--oh-nav-text-hover);
    opacity: 1;
  }

  .footer-bottom {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--oh-glass-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      margin-top: 4rem;
      padding-top: 2rem;
      flex-direction: row;
      justify-content: space-between;
      gap: 1rem;
    }
  }

  .copyright, .made-with {
    font-size: 0.625rem;
    color: var(--oh-nav-text);
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    text-align: center;
  }

  @media (min-width: 768px) {
    .copyright, .made-with {
      font-size: 0.75rem;
      text-align: left;
    }
  }

  .made-with {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .heart {
    color: var(--oh-accent);
  }
</style>
