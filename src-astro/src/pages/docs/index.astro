---
import SiteLayout from '../../layouts/SiteLayout.astro';
import DocsNav from '../../components/docs/DocsNav.astro';
export const prerender = true;
---
<SiteLayout title="OrionHealth — Docs" variant="site">
  <div class="docs-container" data-testid="docs-index">
    <aside class="sidebar">
      <DocsNav />
    </aside>
    <main class="content">
      <h1>Documentación</h1>
      <p>Bienvenido a la documentación de OrionHealth. Selecciona un tema en el menú de la izquierda para comenzar.</p>
    </main>
  </div>
</SiteLayout>

<style>
  .docs-container {
    display: flex;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
    gap: 2rem;
  }
  .sidebar {
    width: 250px;
    flex-shrink: 0;
  }
  .content {
    flex-grow: 1;
    min-width: 0;
  }
  @media (max-width: 768px) {
    .docs-container {
      flex-direction: column;
    }
    .sidebar {
      width: 100%;
    }
  }
</style>
