---
import Layout from '../layouts/Layout.astro';
import { Button, Card, Badge, StatusBadge } from '@swal/ui';
import AuiRenderer from '../components/AuiRenderer.svelte';
import ProBadge from '../components/ProBadge.svelte';
import type { AuiSpec } from '../lib/aui';

const demoAui: AuiSpec = {
  version: 1,
  copy: { title: 'Demo AUI — el agente genera UI de salud', subtitle: 'Con LLM presente, OrionHealth pinta tarjetas clínicas whitelisteadas; sin él, UI estática.' },
  components: [
    { id: 'c1', type: 'Card', props: { variant: 'surface', padding: 'md', title: 'Signos vitales', content: 'TA 120/80 · FC 68 lpm · SpO2 98% — captados offline en tu dispositivo' } },
    { id: 'b1', type: 'Button', props: { variant: 'primary', label: 'Ver historial' } },
    { id: 'bd1', type: 'Badge', props: { variant: 'success', label: '100% on-device' } },
  ],
};

const stats = [
  { label: 'Features', value: '26', variant: 'success' as const },
  { label: 'Privacidad', value: 'on-device', variant: 'info' as const },
  { label: 'Estándares', value: 'FHIR · ICD-10 · LOINC', variant: 'neutral' as const },
  { label: 'Plataformas', value: 'Android · Web PWA', variant: 'warning' as const },
];
---

<Layout title="OrionHealth — Tu salud, soberana y privada">
  <div class="wrap">
    <h1 class="title">Orion<span class="accent">Health</span> — santuario de salud personal</h1>
    <p class="sub">
      Historial médico, medicamentos, citas y asistente con IA <strong>local</strong> (Gemma/RAG on-device).
      Tus datos nunca salen de tu dispositivo. Esta web es la demo pública del stack SWAL:
      Astro 7 + Svelte 5 + <code>@swal/ui</code> + PWA offline sobre Cloudflare Workers.
    </p>

    <div class="stats">
      {stats.map((s) => (
        <Card variant="surface" padding="md">
          <div class="stat"><Badge variant={s.variant}>{s.label}</Badge><span class="val">{s.value}</span></div>
        </Card>
      ))}
    </div>

    <div class="actions">
      <a href="https://orionhealth-docs.pages.dev"><Button variant="primary">Documentación</Button></a>
      <a href="https://app-orionhealth.pages.dev"><Button variant="orange">App completa (Flutter)</Button></a>
      <a href="https://github.com/iberi22/OrionHealth"><Button variant="ghost">GitHub</Button></a>
    </div>

    <div class="status">
      <span class="lab">Estado:</span>
      <StatusBadge status="healthy" /> <span>PWA instalable · offline-first</span>
      <StatusBadge status="healthy" /> <span>mesh swal/orionhealth-web/*</span>
      <StatusBadge status="warning" /> <span>IA local (demo sin PHI real)</span>
      <ProBadge tier="publico" mode="mesh-only" client:load />
    </div>

    <Card variant="elevated" padding="lg">
      <h2>Demo AUI — UI generada por agente</h2>
      <p class="hint">El asistente clínico emite JSON whitelisteado de <code>@swal/ui</code> (Card/Button/Badge/Input/Table) y este renderer lo pinta. Sin LLM, cae a UI estática. Cero PHI en la demo pública.</p>
      <AuiRenderer spec={demoAui} client:load />
    </Card>

    <Card variant="elevated" padding="lg">
      <h2>Instalar como app</h2>
      <ol>
        <li>Abre esta página en Chrome/Edge en tu teléfono o escritorio.</li>
        <li>Menú <code>⋮</code> → <em>Instalar OrionHealth</em> (o el icono de instalación de la barra de direcciones).</li>
        <li>Funciona offline: los assets quedan cacheados por el service worker (Workbox).</li>
      </ol>
      <p class="hint">La app de producción con todos los datos está en <code>app-orionhealth.pages.dev</code> (Flutter) y en el APK de <a href="https://github.com/iberi22/OrionHealth/releases">Releases</a>.</p>
    </Card>
  </div>
</Layout>

<style>
  .wrap { max-width: 1100px; margin: 0 auto; padding: 2rem 1rem; display: grid; gap: 1.25rem; }
  .title { font-size: 1.6rem; font-weight: 800; color: var(--swal-text); letter-spacing: -0.02em; }
  .accent { color: #10b981; }
  .sub { color: var(--swal-text-secondary); line-height: 1.6; }
  .sub code, .hint code, ol code { background: var(--swal-surface); padding: 0.15rem 0.35rem; border-radius: 4px; font-size: 0.85em; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.9rem; }
  .stat { display: flex; flex-direction: column; gap: 0.6rem; }
  .val { font-size: 1.4rem; font-weight: 800; color: var(--swal-text); font-family: var(--swal-font-mono); }
  .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .actions a { text-decoration: none; }
  .status { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; color: var(--swal-text-secondary); font-size: 0.9rem; }
  .lab { color: var(--swal-text-muted); }
  ol, ul { margin: 0; padding-left: 1.25rem; color: var(--swal-text-secondary); line-height: 1.8; }
  h2 { font-size: 1.1rem; font-weight: 700; color: var(--swal-text); margin-bottom: 0.5rem; }
  .hint { color: var(--swal-text-muted); font-size: 0.85rem; margin-top: 0.75rem; }
  .hint a { color: var(--swal-accent); }
</style>
