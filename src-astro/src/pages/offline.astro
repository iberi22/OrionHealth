---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="OrionHealth — Offline" variant="site">
  <div style="max-width: 600px; margin: 2rem auto; padding: 1rem; text-align: center;">
    <h2>Estás offline</h2>
    <p>Parece que no tienes conexión a internet.</p>
    <a href="/app" style="display: inline-block; padding: 0.5rem 1rem; background: #10B981; color: white; text-decoration: none; border-radius: 4px; font-weight: bold;">Ir a la aplicación offline</a>
  </div>
</SiteLayout>
