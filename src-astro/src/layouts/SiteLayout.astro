---
// Common layout of the unified site. Props are the contract; markup and styles are owned by the "site layout" task.
import Layout from './Layout.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
  /** "site" = landing/docs/kb with header and footer; "app" = SPA, no footer. */
  variant?: 'site' | 'app';
}
const { title = 'OrionHealth', variant = 'site' } = Astro.props;
---

<Layout title={title}>
  <script is:inline>
    const theme = (() => {
      try {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('oh-theme')) {
          return localStorage.getItem('oh-theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
      } catch (e) {
        // ignore
      }
      return 'light';
    })();

    if (theme === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
    } else {
      document.documentElement.removeAttribute('data-theme');
    }
  </script>

  <div class="bg-noise"></div>
  <div class="bg-grid"></div>

  <Header variant={variant}>
    <slot name="lock" slot="lock" />
  </Header>
  <main data-variant={variant}><slot /></main>
  {variant === 'site' && <Footer />}
</Layout>

<style>
  main {
    flex: 1;
  }

  .bg-noise {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: var(--oh-noise-opacity);
    z-index: -1;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  .bg-grid {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -10;
    background-image:
      linear-gradient(var(--oh-grid-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--oh-grid-color) 1px, transparent 1px);
    background-size: 40px 40px;
  }
</style>
