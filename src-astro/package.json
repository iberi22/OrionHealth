{
  "name": "orionhealth-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OrionHealth Web PWA — Astro 7 + Svelte 5 + @swal/ui + vite-pwa + edge-mesh + Xavier (demo publica mesh-only, stack SWAL canonico)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:serve": "astro build && astro preview --ignore-lock --host 127.0.0.1",
    "e2e:ta": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "e2e:ta:live": "E2E_TELEMETRY_DISABLED=1 E2E_LIVE_URL=https://orionhealth-web.iberi22.workers.dev e2e run --target live"
  },
  "dependencies": {
    "@swal/ui": "^0.2.0",
    "astro": "^7.3.8",
    "idb": "8.0.4",
    "y-indexeddb": "9.0.12",
    "y-webrtc": "10.3.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/svelte": "^9.0.1",
    "@playwright/test": "1.64.0",
    "@vite-pwa/astro": "1.2.0",
    "autoprefixer": "10.6.1",
    "jsdom": "30.1.2",
    "postcss": "8.5.29",
    "svelte": "^5.57.2",
    "typescript": "^6.0.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.0.3",
    "@e2e-dev/web": "0.14.0",
    "e2e": "0.20.0"
  }
}
