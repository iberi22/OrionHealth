{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orion-health/corpus/sources/registry.schema.json",
  "title": "Source registry",
  "description": "Owner-only. Replaces corpus/ALLOWLIST.json. Effective text policy = min(storage_max, licence ceiling, NC gate); enforced by the validator.",
  "type": "object",
  "required": [
    "schema_version",
    "policy",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy": {
      "type": "object",
      "required": [
        "noncommercial_distribution",
        "extract_max_words",
        "excluded_funding"
      ],
      "additionalProperties": false,
      "properties": {
        "noncommercial_distribution": {
          "type": "boolean"
        },
        "extract_max_words": {
          "type": "integer",
          "minimum": 1
        },
        "excluded_funding": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "industry",
              "mixed",
              "unknown",
              "public",
              "nonprofit"
            ]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "country",
        "org",
        "homepage",
        "entry_urls",
        "hosts",
        "languages",
        "ingest",
        "acquisition",
        "endpoints",
        "licence",
        "storage_max",
        "default_funding_class",
        "cadence",
        "screenshot",
        "priority",
        "status",
        "rate_limit_rps",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(int|[a-z]{2})-[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "national_ministry",
            "guideline_body",
            "hta_agency",
            "intl_org",
            "ngo",
            "literature_db",
            "trial_registry"
          ]
        },
        "country": {
          "type": "string",
          "pattern": "^([A-Z]{2}|INT)$"
        },
        "org": {
          "type": "string",
          "minLength": 1
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "entry_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$"
          }
        },
        "ingest": {
          "type": "string",
          "enum": [
            "curated",
            "bulk"
          ]
        },
        "acquisition": {
          "type": "string",
          "enum": [
            "api",
            "oai-pmh",
            "rss",
            "sitemap",
            "html",
            "pdf",
            "html+pdf"
          ]
        },
        "endpoints": {
          "type": [
            "object",
            "null"
          ]
        },
        "licence": {
          "type": "object",
          "required": [
            "id",
            "family",
            "url",
            "verified",
            "verified_at",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "family": {
              "type": "string",
              "enum": [
                "public-domain",
                "cc-by",
                "cc-by-sa",
                "cc-by-nd",
                "cc-by-nc",
                "cc-by-nc-sa",
                "cc-by-nc-nd",
                "open-gov",
                "copyright",
                "unknown"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "verified": {
              "type": "boolean"
            },
            "verified_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "evidence": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "storage_max": {
          "type": "string",
          "enum": [
            "fulltext",
            "abstract",
            "metadata_only"
          ]
        },
        "default_funding_class": {
          "type": "string",
          "enum": [
            "public",
            "nonprofit",
            "mixed",
            "industry",
            "unknown"
          ]
        },
        "cadence": {
          "type": "string",
          "pattern": "^P[0-9]+[DWM]$"
        },
        "screenshot": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "pending_licence_review",
            "blocked",
            "retired"
          ]
        },
        "rate_limit_rps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
