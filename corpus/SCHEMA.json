{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orion-health/corpus/schema.json",
  "title": "Evidence corpus schemas",
  "description": "Two schemas (v2): $defs.entry (one corpus record per file) and $defs.manifest (corpus/MANIFEST.json). Sources are validated against corpus/sources/registry.json (owner-only), not enumerated here. Rules not expressible here: in git, sections must be [] and screenshot null (text and screenshots live on HF); text_policy must not exceed the source's effective policy; extract.text <= 50 words; funding_class industry is rejected at admission; every funders[].class must match FUNDERS.json; manifest entries must be sorted by id and unique.",
  "$defs": {
    "entry": {
      "type": "object",
      "description": "Schema v2. Every field is required; use null where a field does not apply. content_sha256 is the sha256 of the canonical JSON (sorted keys, UTF-8, no whitespace) computed without content_sha256, retrieved_at and screenshot. In git, sections must be [] and screenshot null.",
      "required": [
        "id",
        "source",
        "country",
        "issuer",
        "url",
        "title",
        "lang",
        "doc_type",
        "published",
        "updated",
        "retrieved_at",
        "licence",
        "licence_family",
        "text_policy",
        "extract",
        "acquisition",
        "funding_class",
        "funders",
        "coi",
        "evidence_level",
        "icd10",
        "mesh",
        "retracted",
        "supersedes",
        "sections",
        "content_sha256",
        "screenshot"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(int|[a-z]{2})-[a-z0-9-]+:[A-Za-z0-9._-]+$",
          "description": "Registry source id, colon, source-local id (e.g. us-ctgov:NCT01234567)."
        },
        "source": {
          "type": "string",
          "pattern": "^(int|[a-z]{2})-[a-z0-9-]+$",
          "description": "Must exist in corpus/sources/registry.json."
        },
        "country": {
          "type": "string",
          "pattern": "^([A-Z]{2}|INT)$",
          "description": "Jurisdiction: ISO-3166-1 alpha-2, or INT for international bodies."
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "description": "Issuing organisation."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Host must belong to the source's hosts in the registry."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$"
        },
        "doc_type": {
          "type": "string",
          "enum": [
            "trial_record",
            "trial_results",
            "guideline",
            "recommendation",
            "systematic_review",
            "primary_study",
            "review",
            "other"
          ]
        },
        "published": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "updated": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC, not in the future."
        },
        "licence": {
          "type": "string",
          "minLength": 1,
          "description": "Licence as stated on the document, else the registry default."
        },
        "licence_family": {
          "type": "string",
          "enum": [
            "public-domain",
            "cc-by",
            "cc-by-sa",
            "cc-by-nd",
            "cc-by-nc",
            "cc-by-nc-sa",
            "cc-by-nc-nd",
            "open-gov",
            "copyright",
            "unknown"
          ]
        },
        "text_policy": {
          "type": "string",
          "enum": [
            "fulltext",
            "abstract",
            "metadata_only"
          ]
        },
        "extract": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "text",
                "source_url"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Verbatim quotation, at most 50 words (validator)."
                },
                "source_url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          ]
        },
        "acquisition": {
          "type": "string",
          "enum": [
            "api",
            "oai-pmh",
            "rss",
            "sitemap",
            "html",
            "pdf",
            "html+pdf"
          ]
        },
        "funding_class": {
          "type": "string",
          "enum": [
            "public",
            "nonprofit",
            "mixed",
            "industry",
            "unknown"
          ],
          "description": "industry is rejected at admission."
        },
        "funders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "class",
              "ror"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "enum": [
                  "public",
                  "nonprofit",
                  "industry"
                ]
              },
              "ror": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^https://ror\\.org/"
              }
            }
          }
        },
        "coi": {
          "type": "object",
          "required": [
            "status",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "declared",
                "none_declared",
                "unknown"
              ]
            },
            "text": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1000
            }
          }
        },
        "evidence_level": {
          "description": "Only if the source states it; otherwise null.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "scale",
                "level",
                "grade",
                "basis"
              ],
              "additionalProperties": false,
              "properties": {
                "scale": {
                  "const": "OCEBM-2011"
                },
                "level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "grade": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Filled only when the source states it."
                },
                "basis": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "For example publication_type."
                }
              }
            }
          ]
        },
        "icd10": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mesh": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retracted": {
          "type": "boolean",
          "const": false,
          "description": "Retracted records are rejected."
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(int|[a-z]{2})-[a-z0-9-]+:[A-Za-z0-9._-]+$"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "heading",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          },
          "maxItems": 0,
          "description": "Must be [] in git; text lives on HF."
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "screenshot": {
          "type": "null",
          "description": "Always null in git; screenshots live on HF."
        }
      }
    },
    "manifest": {
      "type": "object",
      "description": "corpus/MANIFEST.json, generated by scripts/corpus/build-manifest.mjs. entries are sorted by id and must match the files exactly.",
      "required": [
        "schema_version",
        "corpus_version",
        "generated_at",
        "last_refresh",
        "counts",
        "entries"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "corpus_version": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{1,2}\\.[0-9]+$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "last_refresh": {
          "type": "object",
          "required": [
            "week",
            "marker"
          ],
          "additionalProperties": false,
          "properties": {
            "week": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-W[0-9]{2}$"
            },
            "marker": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "counts": {
          "type": "object",
          "required": [
            "by_source",
            "by_funding_class",
            "by_text_policy"
          ],
          "additionalProperties": false,
          "properties": {
            "by_source": {
              "type": "object",
              "propertyNames": {
                "pattern": "^(int|[a-z]{2})-[a-z0-9-]+$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "by_funding_class": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "public",
                  "nonprofit",
                  "mixed",
                  "industry",
                  "unknown"
                ]
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "by_text_policy": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "fulltext",
                  "abstract",
                  "metadata_only"
                ]
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "path",
              "sha256",
              "storage"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(int|[a-z]{2})-[a-z0-9-]+:[A-Za-z0-9._-]+$"
              },
              "path": {
                "type": "string",
                "pattern": "^(corpus/entries/[a-z0-9._-]+/[0-9]{4}/[a-z0-9._-]+\\.json|records/[a-z0-9._-]+/[0-9]{4}\\.jsonl\\.gz)$",
                "description": "git: corpus/entries/...; hf: records/<source>/<yyyy>.jsonl.gz inside the HF dataset."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "storage": {
                "type": "object",
                "required": [
                  "kind",
                  "repo",
                  "revision"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "git",
                      "hf"
                    ]
                  },
                  "repo": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "HF dataset id, e.g. iberi22/orionhealth-evidence; null for git."
                  },
                  "revision": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Commit sha (HF or git); null until published."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
