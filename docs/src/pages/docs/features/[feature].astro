---
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import featuresData from "../../../data/features.json";
import featuresMap from "../../../data/features-map.json";

export async function getStaticPaths() {
  return featuresMap.map((f) => ({
    params: { feature: f.name.toLowerCase().replace(/ & /g, '_').replace(/ /g, '_') },
    props: { featureData: f },
  }));
}

const { feature } = Astro.params;
const { featureData } = Astro.props;

// Find extended data from features.json if available
const extendedData = featuresData.features.find(f => f.name === feature) || {};

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Helper to find relevant screenshots
const screenshots = [
  { path: `${base}/screenshots/05_dashboard_large.png`, label: "Dashboard View" },
  { path: `${base}/screenshots/03_records_page.png`, label: "Records Management" }
];
---

<BaseLayout title={`${featureData.name} - OrionHealth Features`} description={featureData.description}>

  <Header lang="en" />

  <main class="pt-20 pb-16 px-4">
    <div class="container-custom max-w-5xl mx-auto">

      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 text-sm text-bone-dark opacity-60 mb-6">
        <a href={`${base}/dashboard`} class="hover:text-accent transition-colors">Dashboard</a>
        <span>/</span>
        <span class="text-white">{featureData.name}</span>
      </div>

      <div class="flex flex-col md:flex-row justify-between items-start gap-8 mb-12">
        <div class="flex-1">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-accent text-[10px] font-bold uppercase tracking-widest mb-4">
            {featureData.layer} Layer
          </div>
          <h1 class="text-4xl md:text-5xl font-bold tracking-tighter uppercase mb-4">{featureData.name}</h1>
          <p class="text-lg text-bone-dark leading-relaxed opacity-80">
            {featureData.description}
          </p>
        </div>

        <div class="w-full md:w-64 glass rounded-2xl p-6 border border-white/5">
          <div class="text-center mb-6">
            <div class="text-4xl font-bold text-accent mb-1">{featureData.tests}</div>
            <div class="text-[10px] text-bone-dark uppercase tracking-widest opacity-60">Verified Tests</div>
          </div>
          <div class="space-y-4">
            <div class="flex justify-between text-xs">
              <span class="text-bone-dark opacity-60">Status</span>
              <span class="text-emerald-400 font-bold uppercase">{featureData.status}</span>
            </div>
             <div class="flex justify-between text-xs">
              <span class="text-bone-dark opacity-60">Coverage</span>
              <span class="text-white">Full</span>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Technical Details -->
        <div class="lg:col-span-2 space-y-8">
          <section>
            <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent"><path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
              Architecture
            </h2>
            <div class="glass rounded-xl p-6 border border-white/5 bg-white/[0.01]">
              <p class="text-sm text-bone-dark leading-relaxed mb-6">
                Implementation follows Clean Architecture principles, isolating the {featureData.layer} logic from infrastructure concerns.
              </p>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="text-center">
                  <div class="text-xl font-bold text-white mb-1">{extendedData.domain || 0}</div>
                  <div class="text-[10px] text-bone-dark uppercase">Domain</div>
                </div>
                <div class="text-center">
                  <div class="text-xl font-bold text-white mb-1">{extendedData.application || 0}</div>
                  <div class="text-[10px] text-bone-dark uppercase">App</div>
                </div>
                <div class="text-center">
                  <div class="text-xl font-bold text-white mb-1">{extendedData.infrastructure || 0}</div>
                  <div class="text-[10px] text-bone-dark uppercase">Infra</div>
                </div>
                <div class="text-center">
                  <div class="text-xl font-bold text-white mb-1">{extendedData.presentation || 0}</div>
                  <div class="text-[10px] text-bone-dark uppercase">UI</div>
                </div>
              </div>
            </div>
          </section>

          <section>
            <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h14a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              Golden References
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {screenshots.map(s => (
                <div class="group relative aspect-video rounded-xl overflow-hidden border border-white/10 bg-charcoal">
                  <img src={s.path} alt={s.label} class="w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity duration-500" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex items-end p-4">
                    <span class="text-xs font-bold text-white">{s.label}</span>
                  </div>
                </div>
              ))}
            </div>
          </section>
        </div>

        <!-- Sidebar Actions -->
        <div class="space-y-6">
          <div class="glass rounded-xl p-6 border border-white/5">
            <h3 class="text-sm font-bold uppercase tracking-widest mb-4">Actions</h3>
            <div class="space-y-3">
              <button class="w-full py-3 rounded-lg bg-accent text-background text-xs font-bold uppercase tracking-widest hover:scale-[1.02] transition-transform">
                Run Feature Tests
              </button>
              <button class="w-full py-3 rounded-lg border border-white/10 text-white text-xs font-bold uppercase tracking-widest hover:bg-white/5 transition-colors">
                View Source Code
              </button>
            </div>
          </div>

          <div class="glass rounded-xl p-6 border border-white/5">
            <h3 class="text-sm font-bold uppercase tracking-widest mb-4">CI Metrics</h3>
            <div class="space-y-4">
              <div>
                <div class="flex justify-between text-[10px] uppercase mb-1">
                  <span class="text-bone-dark opacity-60">LINT SCORE</span>
                  <span class="text-emerald-400">100/100</span>
                </div>
                <div class="h-1 w-full bg-white/5 rounded-full overflow-hidden">
                  <div class="h-full bg-emerald-500 w-full"></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between text-[10px] uppercase mb-1">
                  <span class="text-bone-dark opacity-60">COVERAGE</span>
                  <span class="text-accent">94.2%</span>
                </div>
                <div class="h-1 w-full bg-white/5 rounded-full overflow-hidden">
                  <div class="h-full bg-accent w-[94.2%]"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>

  <Footer lang="en" />
</BaseLayout>
