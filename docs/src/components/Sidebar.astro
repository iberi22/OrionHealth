---
// Sidebar.astro - Component listing all 25 features and documentation links
import { getCollection } from 'astro:content';

const allFeatures = await getCollection('features');
// Sort by REQ ID
const features = allFeatures.sort((a, b) => a.data.req_id.localeCompare(b.data.req_id));

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<aside class="w-full md:w-64 glass rounded-2xl p-6 border border-white/5 space-y-6">
  <div>
    <h3 class="text-xs font-bold uppercase tracking-widest text-accent mb-3">System Specification</h3>
    <ul class="space-y-2 text-xs">
      <li>
        <a href={`${base}/SRS/REQUIREMENTS.md`} class="text-bone-dark hover:text-accent transition-colors flex items-center gap-2">
          <span>📋</span> SRS Canonical Index
        </a>
      </li>
    </ul>
  </div>

  <div>
    <h3 class="text-xs font-bold uppercase tracking-widest text-accent mb-3">Features (25)</h3>
    <ul class="space-y-1.5 text-xs max-h-[60vh] overflow-y-auto pr-2">
      {features.map((f) => {
        const statusColor = f.data.status === 'implemented' ? 'text-emerald-400' : f.data.status === 'partial' ? 'text-amber-400' : 'text-slate-400';
        return (
          <li>
            <a
              href={`${base}/docs/features/${f.id}`}
              class="text-bone-dark opacity-80 hover:opacity-100 hover:text-white transition-colors flex items-center justify-between py-1 border-b border-white/5"
            >
              <span class="truncate font-medium">{f.data.req_id}: {f.data.title}</span>
              <span class={`text-[9px] uppercase font-bold ${statusColor}`}>{f.data.status}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</aside>
